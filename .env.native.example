# ─────────────────────────────────────────────────────────────────────────
# AgOS — шаблон env для НАТИВНОЙ сборки (Capacitor iOS/Android).
#
# Vite в режиме `--mode native` читает `.env.native` (gitignored) ПОВЕРХ `.env`.
# Скопируй: cp .env.native.example .env.native — и продублируй сюда VITE_SUPABASE_*
# из своего `.env` (публичные значения, те же, что для web).
#
# VITE_APP_TARGET=native режет роутер (App.tsx): монтируются только /cabinet, /mpk и
# auth-экраны; публичный сайт и /admin в нативный бандл не попадают (Apple 4.2,
# EngSpec NativeApp §8). С 2026-09-17 флаг также выставляется прямо в npm-скрипте
# `build:native`, поэтому отсутствие этого файла больше не даёт «обёрнутый сайт» —
# файл нужен, если хочешь переопределить для нативки другие VITE_* (например, URL сервисов).
# ─────────────────────────────────────────────────────────────────────────
VITE_APP_TARGET=native

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_GATEWAY_URL=
VITE_CONSULTING_ENGINE_URL=
